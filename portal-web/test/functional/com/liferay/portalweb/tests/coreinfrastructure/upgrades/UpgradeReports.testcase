@component-name = "portal-upgrades"
definition {

	property app.server.types = "tomcat";
	property database.partition.enabled = "true";
	property database.types = "mysql";
	property liferay.online.properties = "true";
	property portal.release = "true";
	property portal.upstream = "true";
	property test.assert.warning.exceptions = "true";
	property test.run.environment = "EE";
	property testray.main.component.name = "Upgrades Core";



	//var tempFileExists = FileUtil.exists("${tempDir}/tools/portal-tools-db-upgrade-client/reports/upgrade_report.info");

	setUp {
		User.loginPG(
			nodePort = "8080",
			password = "test",
			userEmailAddress = "test@liferay.com");

		SearchAdministration.executeReindex();
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		//if ("${testPortalInstance}" == "true") {
		//	PortalInstances.tearDownCP();
		//}
		//else {
		//	if ("${tempFileExists}" == "true") {
		//	//FileUtil.delete("${tempDir}/tools/portal-tools-db-upgrade-client/reports/upgrade_report.info");
		//}
		//}

	}

	@description = "LPS-154683: Upgrade Report is not created when property is not set to true"
	@priority = "4"
	test UpgradeFileDoesNotExist {
		task("Set the properties needed to run the upgrade"){
            property test.name.skip.portal.instance = "UpgradeReports#UpgradeFileDoesNotExist";
            property data.archive.type = "data-archive-portal-settings";
		    property database.types = "mariadb,mysql,postgresql";
		    property portal.version = "7.0.4";
        }

        task("Look for the upgrade report"){
		    var tempDir = PropsUtil.get("liferay.home.dir.name");
		    var tempFileExists = FileUtil.exists("${tempDir}/tools/portal-tools-db-upgrade-client/reports/upgrade_report.info");
        }

		task ("Check if file doesn't exists") {
			if ("${tempFileExists}" == "true") {
				fail("Exist");
			}
		}
	}

	@description = "LPS-154683: Upgrade Report is created when property is set to true"
	@priority = "4"
	test UpgradeFileExist {
		task("Set the properties needed to run the upgrade"){
            property test.name.skip.portal.instance = "UpgradeReports#UpgradeFileExist";
            property upgrade.reports.enabled = "true";
            property data.archive.type = "data-archive-portal-settings";
		    property database.types = "mariadb,mysql,postgresql";
		    property portal.version = "7.0.4";
        }

        task("Look for the upgrade report"){
		    var tempDir = PropsUtil.get("liferay.home.dir.name");
		    var tempFileExists = FileUtil.exists("${tempDir}/tools/portal-tools-db-upgrade-client/reports/upgrade_report.info");
        }

		task ("Check if file exists") {
			if ("${tempFileExists}" != "true") {
				fail("File Does Not Exist");
			}
		}
	}

	@description = "LPS-154683: Upgrade Report shows warnings"
	@priority = "4"
	test UpgradeReportShowWarnings {
		task("Set the properties needed to run the upgrade"){
            property test.name.skip.portal.instance = "UpgradeReports#UpgradeReportShowWarnings";
            property upgrade.reports.enabled = "true";
            property data.archive.type = "data-archive-portal-settings";
		    property database.types = "mariadb,mysql,postgresql";
		    property portal.version = "7.0.4";
        }

        task("Look for the upgrade report"){
		    var tempDir = PropsUtil.get("liferay.home.dir.name");
		    var logString = "Warnings thrown during upgrade process";
		    var fileContent = FileUtil.read("${tempDir}/tools/portal-tools-db-upgrade-client/reports/upgrade_report.info");
        }
		
		task ("Read the content. Warnings expected") {
			if (!(contains("${fileContent}", "${logString}"))) {
				fail("Report without Warnings");
			}
		}
	}

	@description = "LPS-154683: Upgrade Report does not show errors and warning"
	@priority = "4"
	test UpgradeReportWithoutErrors {
		task("Set the properties needed to run the upgrade"){
            property test.name.skip.portal.instance = "UpgradeReports#UpgradeReportWithoutErrors";
            property upgrade.reports.enabled = "true";
            property data.archive.type = "data-archive-portal-settings";
		    property database.types = "mariadb,mysql,postgresql";
		    property portal.version = "7.0.4";
        }

        task("Look for the upgrade report"){
		    var tempDir = PropsUtil.get("liferay.home.dir.name");
		    var logString = "No errors thrown during upgrade";
		    var fileContent = FileUtil.read("${tempDir}/tools/portal-tools-db-upgrade-client/reports/upgrade_report.info");
        }

		task ("Read the content. No errors expected") {
			if (!(contains("${fileContent}", "${logString}"))) {
				fail("Report with Errors");
			}
		}
	}

    @description = "LPS-154683: Upgrade Report shows errors"
	@priority = "4"
	test UpgradeReportWithErrors {
		task("Set the properties needed to run the upgrade"){
            property test.name.skip.portal.instance = "UpgradeReports#UpgradeReportWithErrors";
            property upgrade.reports.enabled = "true";
            property data.archive.type = "data-archive-portal-settings";
		    property database.types = "mariadb,mysql,postgresql";
		    property portal.version = "7.0.4";
        }

        task("Look for the upgrade report"){
		    var tempDir = PropsUtil.get("liferay.home.dir.name");
		    var logString = "Errors thrown during upgrade";
		    var fileContent = FileUtil.read("${tempDir}/tools/portal-tools-db-upgrade-client/reports/upgrade_report.info");
		    echo("${fileContent}");
        }
		
		task ("Read the content. No errors expected") {
			if ((contains("${fileContent}", "${logString}"))) {
				fail("Report without Errors");
			}
		}
	}

    @description = "LPS-154683: Upgrade Report Check version and number of row tables"
	@priority = "4"
    @ignore = "true"
	test UpgradeReportCheckVersionAndNumberOfTables {
		task("Set the properties needed to run the upgrade"){
            property test.name.skip.portal.instance = "UpgradeReports#UpgradeReportCheckVersionAndNumberOfTables";
            property upgrade.reports.enabled = "true";
            property data.archive.type = "data-archive-portal-settings";
		    property database.types = "mariadb,mysql,postgresql";
		    property portal.version = "7.0.4";
        }

        task("Somehow read the version and number of tables in database"){

        }

		//var tempDir = PropsUtil.get("liferay.home.dir.name");
		//var logString = "No errors thrown during upgrade";
		//var fileContent = FileUtil.read("${tempDir}/tools/portal-tools-db-upgrade-client/reports/upgrade_report.info");
		//echo("${fileContent}");
		//task ("Read the content. No errors expected") {
		//	if (!(contains("${fileContent}", "${logString}"))) {
				fail("Report with Errors");
		//	}
		//}
	}

} 