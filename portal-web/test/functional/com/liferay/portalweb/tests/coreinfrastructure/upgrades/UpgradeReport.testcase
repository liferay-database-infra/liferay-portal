@component-name = "portal-upgrades"
definition {

	property app.server.types = "tomcat";
	property data.archive.type = "data-archive-portal";
	property database.types = "mysql";
	property portal.release = "true";
	property portal.upstream = "true";
	property portal.version = "7.4.13";
	property testray.main.component.name = "Upgrades Core";
	property upgrade.reports.enabled = "true";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}

		var liferayHome = PropsUtil.get("liferay.home.dir.name");

		var reportFile = FileUtil.exists("${liferayHome}/tools/portal-tools-db-upgrade-client/reports/upgrade_report.info");

		if ("${reportFile}" == "true") {
			FileUtil.delete("${liferayHome}/tools/portal-tools-db-upgrade-client/reports/upgrade_report.info");
		}
	}

	@description = "LPS-154683: Upgrade Report is not created when property is not set to true"
	@priority = "4"
	test UpgradeFileDoesNotExistUpgradeTool {
		property upgrade.reports.enabled = "false";

		task ("Look for the upgrade report") {
			var liferayHome = PropsUtil.get("liferay.home.dir.name");

			var reportFileExists = FileUtil.exists("${liferayHome}/tools/portal-tools-db-upgrade-client/reports/upgrade_report.info");
		}

		task ("Check file doesn't exist") {
			if ("${reportFileExists}" == "true") {
				fail("Upgrade report found in ${liferayHome}/tools/portal-tools-db-upgrade-client/reports/");
			}
		}
	}

	@description = "LPS-154683: Upgrade Report is created when property is set to true"
	@priority = "4"
	test UpgradeFileExistUpgradeTool {
		task ("Look for the upgrade report") {
			var liferayHome = PropsUtil.get("liferay.home.dir.name");

			var reportFileExists = FileUtil.exists("${liferayHome}/tools/portal-tools-db-upgrade-client/reports/upgrade_report.info");
		}

		task ("Check if file exists") {
			if ("${reportFileExists}" != "true") {
				fail("Upgrade report not found in ${liferayHome}/tools/portal-tools-db-upgrade-client/reports/");
			}
		}
	}

	@description = "LPS-154683: Upgrade Report Check number of row tables"
	@ignore = "true"
	@priority = "4"
	@refactorneeded
	test UpgradeReportCheckNumberOfTablesUpgradeTool {
		task ("Read the  number of rows in database") {
			var numberOfRows = Upgrade.getNumberOfRowsFromTable(tableName = "ResourcePermission");
		}

		task ("Look for the upgrade report") {
			var liferayHome = PropsUtil.get("liferay.home.dir.name");
			var logString = "${numberOfRows}";
			var fileContent = FileUtil.read("${liferayHome}/tools/portal-tools-db-upgrade-client/reports/upgrade_report.info");

			echo("${fileContent}");
		}

		task ("Read the version is correct in the report") {
			if (contains("${fileContent}", "${logString1}")) {
				fail("Database version is not present in upgrade report.");
			}
		}
	}

	@description = "LPS-154683: Upgrade Report Check version"
	@priority = "4"
	test UpgradeReportCheckVersionUpgradeTool {
		task ("Read the version in database") {
			var databaseVersion = Upgrade.getDatabaseVersion();
		}

		task ("Look for the upgrade report") {
			var liferayHome = PropsUtil.get("liferay.home.dir.name");
			var logString = "Final portal build number: ${databaseVersion}";
			var fileContent = FileUtil.read("${liferayHome}/tools/portal-tools-db-upgrade-client/reports/upgrade_report.info");

			echo("${fileContent}");
		}

		task ("Read the version is correct in the report") {
			if (contains("${fileContent}", "${logString}")) {
				fail("Database version is not present in upgrade report.");
			}
		}
	}

	@description = "LPS-154683: Upgrade Report shows warnings"
	@ignore = "true"
	@refactorneeded
	@priority = "4"
	test UpgradeReportShowWarningsUpgradeTool {
		task ("Look for the upgrade report") {
			var liferayHome = PropsUtil.get("liferay.home.dir.name");
			var logString = "Warnings thrown during upgrade process";
			var fileContent = FileUtil.read("${liferayHome}/tools/portal-tools-db-upgrade-client/reports/upgrade_report.info");
		}

		task ("Read the content. Warnings expected") {
			if (!(contains("${fileContent}", "${logString}"))) {
				fail("Upgrade report does not contain expected warnings.");
			}
		}
	}

	@description = "LPS-154683: Upgrade Report shows errors"
	@ignore = "true"
	@priority = "4"
	@refactorneeded
	test UpgradeReportWithErrorsUpgradeTool {
		property portal.version = "6.0.12";

		task ("Look for the upgrade report") {
			var liferayHome = PropsUtil.get("liferay.home.dir.name");
			var logString = "Errors thrown during upgrade";
			var fileContent = FileUtil.read("${liferayHome}/tools/portal-tools-db-upgrade-client/reports/upgrade_report.info");

			echo("${fileContent}");
		}

		task ("Read the content. No errors expected") {
			if (contains("${fileContent}", "${logString}")) {
				fail("Upgrade report does not contain expected errors.");
			}
		}
	}

	@description = "LPS-154683: Upgrade Report does not show errors and warning"
	@priority = "4"
	test UpgradeReportWithoutErrorsUpgradeTool {
		task ("Look for the upgrade report") {
			var liferayHome = PropsUtil.get("liferay.home.dir.name");
			var logString = "No errors thrown during upgrade";
			var fileContent = FileUtil.read("${liferayHome}/tools/portal-tools-db-upgrade-client/reports/upgrade_report.info");
		}

		task ("Read the content. No errors expected") {
			if (!(contains("${fileContent}", "${logString}"))) {
				fail("Upgrade report contains errors.");
			}
		}
	}

	@description = "LPS-154683: Upgrade Report does not show errors and warning"
	@priority = "4"
	test UpgradeReportWarningsUpgradeTool {
		task ("Look for the upgrade report") {
			var liferayHome = PropsUtil.get("liferay.home.dir.name");
			var logString = "Warnings thrown during upgrade process";
			var fileContent = FileUtil.read("${liferayHome}/tools/portal-tools-db-upgrade-client/reports/upgrade_report.info");

			echo("${fileContent}");
		}

		task ("Read the content. No errors expected") {
			if (contains("${fileContent}", "${logString}")) {
				fail("Upgrade report contains expected warnings.");
			}
		}
	}

}