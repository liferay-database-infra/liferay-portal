@component-name = "portal-database-upgrade-framework"
definition {

	property app.server.types = "tomcat";
	property database.types = "mysql";
	property portal.release = "true";
	property portal.upstream = "true";
    property custom.properties = "upgrade.database.auto.run=true";
	property testray.main.component.name = "Database Upgrade Framework";
	property skip.start.app.server = "true";

	setUp {
		task ("Given the enviroment is set AND upgrade.database.auto.run is enabled") {
			AntCommands.runCommand("modules/util/portal-tools-db-upgrade-client/src/testFunctional/ant/build-test-db-upgrade-client.xml", "modify-setenv-script");
		}
	}
	
	tearDown {
		AntCommands.runCommand("modules/util/portal-tools-db-upgrade-client/src/testFunctional/ant/build-test-db-upgrade-client.xml", "clean-upgrade-manager");
	}

	@priority = 5
	test CheckMbeanFailedUpgrade {
		property portal.version = "7.4.13";
		property data.archive.type = "data-archive-portal";
		property skip.upgrade-legacy-database = "true";
		property custom.mysql.sql.statement = "ALTER TABLE FragmentComposition DROP description;";

		task ("When the portal is started with auto.upgrade enabled AND failures were registered during the upgrade") {
			AntCommands.runCommand("modules/util/portal-tools-db-upgrade-client/src/testFunctional/ant/build-test-db-upgrade-client.xml", "check-mbean-attributes");
		}

		task ("Then look for the mbean output file") {
			var projectDir = PropsUtil.get("project.dir");

			var mBeanAttibutesFile = FileUtil.read("${projectDir}/mbean-attributes-output.txt");
		}

		task ("And the status of the upgrade is published as failure in the JVM via mBean") {
			if (!(contains(${mBeanAttibutesFile}, "Type: major"))) {
				echo(${mBeanAttibutesFile});

				fail("Expected upgrade type not present in the mBean file");
			}

			if (!(contains(${mBeanAttibutesFile}, "Result: failure"))) {
				echo(${mBeanAttibutesFile});

				fail("Expected upgrade result not present in the mBean file");
			}
		}
	}

	@priority = 4
	test CheckMbeanSuccessfulUpgrade {
		property portal.version = "7.4.13";
		property data.archive.type = "data-archive-portal";
		property skip.upgrade-legacy-database = "true";
		
		task ("When the portal is started AND the upgrade is executed successfully") {
			AntCommands.runCommand("modules/util/portal-tools-db-upgrade-client/src/testFunctional/ant/build-test-db-upgrade-client.xml", "check-mbean-attributes");
		}

		task ("Then look for the mbean output file") {
			var projectDir = PropsUtil.get("project.dir");

			var mBeanAttibutesFile = FileUtil.read("${projectDir}/mbean-attributes-output.txt");
		}

		task ("And the status of the upgrade is published as success in the JVM via mBean") {
			if (!(contains(${mBeanAttibutesFile}, "Type: major"))) {
				echo(${mBeanAttibutesFile});

				fail("Expected upgrade type not present in the mBean file");
			}

			if (!(contains(${mBeanAttibutesFile}, "Result: success"))) {
				echo(${mBeanAttibutesFile});

				fail("Expected upgrade result not present in the mBean file");
			}
		}
	}

	@priority = 4
	test CheckMbeanWarningUpgrade {
		property skip.get.testcase.database.properties = "true";
		property portal.version = "7.4.13";
		property data.archive.type = "data-archive-portal";
		property skip.upgrade-legacy-database = "true";
		property test.assert.warning.exceptions = "false";

		task ("When the indexes.sql file from portal-impl.jar is deleted") {
			AntCommands.runCommand("modules/util/portal-tools-db-upgrade-client/src/testFunctional/ant/build-test-db-upgrade-client.xml", "delete-indexes-sql");
		}

		task ("When the portal is started with auto.upgrade enabled AND a warn is registered during upgrade") {
			AntCommands.runCommand("modules/util/portal-tools-db-upgrade-client/src/testFunctional/ant/build-test-db-upgrade-client.xml", "check-mbean-attributes");
		}

		task ("Then look for the mbean output file") {
			var projectDir = PropsUtil.get("project.dir");

			var mBeanAttibutesFile = FileUtil.read("${projectDir}/mbean-attributes-output.txt");
		}

		task ("And the status of the upgrade is published as warning in the JVM via mBean") {
			if (!(contains(${mBeanAttibutesFile}, "Type: major"))) {
				echo(${mBeanAttibutesFile});

				fail("Expected upgrade type not present in the mBean file");
			}

			if (!(contains(${mBeanAttibutesFile}, "Result: warning"))) {
				echo(${mBeanAttibutesFile});

				fail("Expected upgrade result not present in the mBean file");
			}
		}
	}

	@priority = 5
	test CheckMbeanWhenUpgradeHaveWarnAndError {
		property skip.get.testcase.database.properties = "true";
		property portal.version = "7.4.13";
		property data.archive.type = "data-archive-portal";
		property skip.upgrade-legacy-database = "true";
		property test.assert.warning.exceptions = "false";
		property custom.mysql.sql.statement = "ALTER TABLE FragmentComposition DROP description;";

		task ("When the indexes.sql file from portal-impl.jar is deleted") {
			AntCommands.runCommand("modules/util/portal-tools-db-upgrade-client/src/testFunctional/ant/build-test-db-upgrade-client.xml", "delete-indexes-sql");
		}

		task ("When the portal is started with auto.upgrade enabled AND warn and errors were registered during upgrade") {
			AntCommands.runCommand("modules/util/portal-tools-db-upgrade-client/src/testFunctional/ant/build-test-db-upgrade-client.xml", "check-mbean-attributes");
		}

		task ("Then look for the mbean output file") {
			var projectDir = PropsUtil.get("project.dir");

			var mBeanAttibutesFile = FileUtil.read("${projectDir}/mbean-attributes-output.txt");
		}

		task ("And the status of the upgrade is published as failure in the JVM via mBean") {
			if (!(contains(${mBeanAttibutesFile}, "Type: major"))) {
				echo(${mBeanAttibutesFile});

				fail("Expected upgrade type not present in the mBean file");
			}

			if (!(contains(${mBeanAttibutesFile}, "Result: failure"))) {
				echo(${mBeanAttibutesFile});

				fail("Expected upgrade result not present in the mBean file");
			}
		}
	}

	@priority = 4
	test CheckMbeanWhenUpgradeItsNotExecuted {
		task ("When no upgrade processes runned") {
			AntCommands.runCommand("modules/util/portal-tools-db-upgrade-client/src/testFunctional/ant/build-test-db-upgrade-client.xml", "check-mbean-attributes");
		}

		task ("Then look for the mbean output file") {
			var projectDir = PropsUtil.get("project.dir");

			var mBeanAttibutesFile = FileUtil.read("${projectDir}/mbean-attributes-output.txt");
		}

		task ("And the status of the upgrade is published as 'no upgrade' in the JVM via mBean") {
			if (!(contains(${mBeanAttibutesFile}, "Type: no upgrade"))) {
				echo(${mBeanAttibutesFile});

				fail("Expected upgrade type not present in the mBean file");
			}

			if (!(contains(${mBeanAttibutesFile}, "Result: success"))) {
				echo(${mBeanAttibutesFile});

				fail("Expected upgrade result not present in the mBean file");
			}
		}
	}

}