@component-name = "portal-database-upgrade-framework"
definition {

	property app.server.types = "tomcat";
	property database.types = "mysql";
	property portal.release = "true";
	property portal.upstream = "true";
    property custom.properties = "upgrade.database.auto.run=true";
	property testray.main.component.name = "Database Upgrade Framework";
	property skip.start.app.server = "true";

	setUp {
		task ("Given the enviroment is set AND upgrade.database.auto.run is enabled") {
			AntCommands.runCommand("modules/util/portal-tools-db-upgrade-client/src/testFunctional/ant/build-test-db-upgrade-client.xml", "modify-setenv-script");
		}
	}
	
	tearDown {
		AntCommands.runCommand("modules/util/portal-tools-db-upgrade-client/src/testFunctional/ant/build-test-db-upgrade-client.xml", "clean-upgrade-manager");
	}

	@priority = 4
	test CheckMbeanWhenUpgradeItsNotExecuted {
		task ("When no upgrade processes runned") {
			AntCommands.runCommand("modules/util/portal-tools-db-upgrade-client/src/testFunctional/ant/build-test-db-upgrade-client.xml", "check-mbean-attributes");
		}

		task ("Then look for the mbean output file") {
			var projectDir = PropsUtil.get("project.dir");

			var mBeanAttibutesFile = FileUtil.read("${projectDir}/mbean-attributes-output.txt");
		}

		task ("And the status of the upgrade is published as 'no upgrade' in the JVM via mBean") {
			if (!(contains(${mBeanAttibutesFile}, "Type: no upgrade"))) {
				echo(${mBeanAttibutesFile});

				fail("Expected upgrade type not present in the mBean file");
			}

			if (!(contains(${mBeanAttibutesFile}, "Result: success"))) {
				echo(${mBeanAttibutesFile});

				fail("Expected upgrade result not present in the mBean file");
			}
		}
	}

}